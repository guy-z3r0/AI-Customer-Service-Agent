# Copy this file to ".env" and edit the values you actually have.
# Every value starting with PLACEHOLDER_ is deliberately fake: the stack boots and
# the panel runs with all of them untouched. Features that need a real value
# switch themselves off politely instead of crashing.

# --- Postgres ---
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=PLACEHOLDER_DB_PASSWORD

# JDBC url the Java backend uses. Inside docker compose the database host is
# "postgres"; when you run the backend on your own machine use "localhost".
DB_URL=jdbc:postgresql://postgres:5432/agent

# --- Ports (host side) ---
JAVA_PORT=8080
PY_PORT=8090

# --- Encryption of client phone/email columns (pgcrypto) ---
# Replace with a long random string before storing real customer contacts.
# Changing it later makes rows encrypted with the old key unreadable.
PII_ENC_KEY=PLACEHOLDER_PII_ENC_KEY

# --- Google Cloud speech credentials (needed from Phase 2 onward) ---
# Point this at a real service-account JSON file to turn on Google STT/TTS.
# Left as-is, the voice server falls back to the free offline providers.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-credentials.json
