# --- Java / Maven ---
target/

# --- IDE ---
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# --- OS ---
.DS_Store
Thumbs.db

# --- App-generated ---
# Runtime logs only. The phase logs and test scripts under docs/ors/logs/ are
# part of the build record and belong in git — this pattern was swallowing them.
logs/
!docs/ors/logs/
*.class
*.lst

# --- The version 1 data tree ---
# It held a credential (config.json) and example customer records with a
# real-looking name, phone number and gmail address in them, all committed.
# Nothing in version 2 reads any of it except the one-shot importer, which
# reads it off disk — so it stays on disk and out of git.
java-backend/data/

# --- Secrets & local environment ---
# The committed *.PLACEHOLDER files show the shape; the real ones never land in git.
.env
secrets/*
!secrets/*.PLACEHOLDER
java-backend/.embedded-postgres
SECURITY-AUDIT.md
suggested-updates.md
java-backend/src/test/java/com/ulab/agent/security/TwilioSecurityTest.java
java-backend/src/test/java/com/ulab/agent/services/ConfigServiceTest.java
